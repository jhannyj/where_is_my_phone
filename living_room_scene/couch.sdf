<?xml version="1.0"?>
<sdf version="1.7">
  <model name="couch">
    <!-- Legs are visual-only so a robot can reach under the body (0.15 m clearance). -->
    <link name="base_link">
      <collision name="seat_collision"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.9 2 0.3</size></box></geometry></collision>
      <visual name="seat_visual"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.9 2 0.3</size></box></geometry><material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      <collision name="back_collision"><pose>-0.35 0 0.65 0 0 0</pose><geometry><box><size>0.2 2 0.4</size></box></geometry></collision>
      <visual name="back_visual"><pose>-0.35 0 0.65 0 0 0</pose><geometry><box><size>0.2 2 0.4</size></box></geometry><material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      <collision name="arm_left_collision"><pose>0 0.9 0.575 0 0 0</pose><geometry><box><size>0.9 0.2 0.25</size></box></geometry></collision>
      <visual name="arm_left_visual"><pose>0 0.9 0.575 0 0 0</pose><geometry><box><size>0.9 0.2 0.25</size></box></geometry><material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      <collision name="arm_right_collision"><pose>0 -0.9 0.575 0 0 0</pose><geometry><box><size>0.9 0.2 0.25</size></box></geometry></collision>
      <visual name="arm_right_visual"><pose>0 -0.9 0.575 0 0 0</pose><geometry><box><size>0.9 0.2 0.25</size></box></geometry><material><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      <visual name="leg0_visual"><pose>0.38 0.9 0.075 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="leg1_visual"><pose>0.38 -0.9 0.075 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="leg2_visual"><pose>-0.38 0.9 0.075 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="leg3_visual"><pose>-0.38 -0.9 0.075 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
