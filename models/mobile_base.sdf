<?xml version="1.0"?>
<sdf version="1.7">
  <!--
    Holonomic mobile base: three actuated virtual joints from the world,
      world --(x_joint, prismatic)--> x_link --(y_joint, prismatic)--> y_link
            --(yaw_joint, continuous)--> chassis_link
    The wheels are visual only (we do not simulate wheel contact); the virtual
    joints carry the base. See docs/DECISIONS.md D-001.
    chassis_link's frame sits at wheel-axle height (z = 0.12 m), so the wheels
    touch the floor and the chassis bottom has 0.12 m of ground clearance.
  -->
  <model name="mobile_base">
    <link name="x_link">
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <link name="y_link">
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>

    <link name="chassis_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial>
        <mass>100.0</mass>
        <inertia>
          <ixx>2.0</ixx><iyy>2.0</iyy><izz>2.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Main Chassis -->
      <visual name="chassis_visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.8 0.6 0.2</size></box></geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <collision name="chassis_collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.8 0.6 0.2</size></box></geometry>
      </collision>

      <!-- Front marker (+x) so heading is visible -->
      <visual name="front_marker">
        <pose>0.39 0 0.17 0 0 0</pose>
        <geometry><box><size>0.04 0.2 0.04</size></box></geometry>
        <material><diffuse>0.95 0.8 0.1 1</diffuse></material>
      </visual>

      <!-- Wheels (visual only) -->
      <visual name="wheel_fl">
        <pose>0.3 0.33 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="wheel_fr">
        <pose>0.3 -0.33 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="wheel_rl">
        <pose>-0.3 0.33 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="wheel_rr">
        <pose>-0.3 -0.33 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="x_joint" type="prismatic">
      <parent>world</parent>
      <child>x_link</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-10</lower><upper>10</upper><effort>2000</effort><velocity>2.0</velocity></limit></axis>
    </joint>
    <joint name="y_joint" type="prismatic">
      <parent>x_link</parent>
      <child>y_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-10</lower><upper>10</upper><effort>2000</effort><velocity>2.0</velocity></limit></axis>
    </joint>
    <!-- Continuous (no limits) so the base can turn the short way round. -->
    <joint name="yaw_joint" type="continuous">
      <parent>y_link</parent>
      <child>chassis_link</child>
      <axis><xyz>0 0 1</xyz><limit><effort>1000</effort><velocity>2.0</velocity></limit></axis>
    </joint>
  </model>
</sdf>
