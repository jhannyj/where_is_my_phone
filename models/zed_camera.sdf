<?xml version="1.0"?>
<sdf version="1.7">
  <model name="zed_camera">
    <link name="camera_body">
      <inertial>
        <mass>0.16</mass> <!-- ZED cameras are quite light -->
        <inertia>
          <ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.03 0.175 0.03</size></box></geometry>
        <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.03 0.175 0.03</size></box></geometry>
      </collision>

      <!-- Drake RGBD Sensor configuration -->
      <sensor name="zed_rgbd" type="rgbd_camera">
        <!-- Pose relative to the camera body -->
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.91986</horizontal_fov> <!-- ~110 degrees for ZED -->
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.3</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
